# ==========================================
# LearnFlow AI — Environment Configuration
# ==========================================

# Project
PROJECT_NAME="LearnFlow AI — Adaptive Multi-Agent Tutor"
VERSION="1.0.0"

# Database (Default: SQLite zero-friction local DB, or PostgreSQL + pgvector)
DATABASE_URL="sqlite:///./learnflow.db"
# DATABASE_URL="postgresql://learnflow_user:learnflow_pass@localhost:5432/learnflow_db"

# Security & JWT Auth
JWT_SECRET="learnflow-hackathon-2026-super-secret-key-321"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI & LLM Provider Configuration
# Options: "fallback" (instant deterministic local engine), "ollama", "openai", "gemini"
LLM_PROVIDER="fallback"
LLM_MODEL="llama3:latest"

# Ollama Local Configuration (if LLM_PROVIDER="ollama")
OLLAMA_BASE_URL="http://localhost:11434"

# Optional Cloud API Keys (if LLM_PROVIDER="openai" or "gemini")
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Vector Embeddings
# Options: "tfidf_cosine" (zero-dependency built-in), "openai", "ollama"
EMBEDDING_PROVIDER="tfidf_cosine"
EMBEDDING_MODEL="all-MiniLM-L6-v2"

# Storage
UPLOAD_DIR="./uploads"

# Frontend API Target
VITE_API_URL="http://localhost:8000/api"
